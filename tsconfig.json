{
  "compilerOptions": {
    "target": "es2016", 
    "module": "commonjs",
    "rootDir": "./src",        // Tells the compiler where your TS files are
    "outDir": "./dist",        // Where to put the compiled JS files
    "declaration": true,       // Generates .d.ts files for users who use TypeScript
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
