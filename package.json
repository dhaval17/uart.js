{
  "name": "@dhaval/uart.js",
  "version": "1.1.0",
  "description": "A robust, event-driven TypeScript UART module for Node.js to read, analyze, and write serial data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsx --test test/unit/*.test.ts",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "example": "tsx test/integration/example.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaval17/uart.js.git"
  },
  "author": "Dhaval Chauhan",
  "license": "ISC",
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
